{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4a5b-9c8d-7e6f5a4b3c2d",
		"name": "Smart-Campus-Resources",
		"description": "Resource management. **Set `accessToken`** (Auth collection → Login).\n\n- **GET** endpoints: any authenticated role (ADMIN / TECHNICIAN / USER).\n- **POST, PUT, PATCH (mutations), DELETE:** ADMIN only.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "resourceId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Create Resource (ADMIN)",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\": \"Lecture Hall 01\",\r\n    \"description\": \"Main lecture hall for computing faculty\",\r\n    \"type\": \"LECTURE_HALL\",\r\n    \"capacity\": 150,\r\n    \"location\": \"Building A, Floor 2\",\r\n    \"availableFrom\": \"08:00:00\",\r\n    \"availableTo\": \"20:00:00\",\r\n    \"status\": \"ACTIVE\",\r\n    \"condition\": \"EXCELLENT\",\r\n    \"inspectionNotes\": \"Newly renovated\"\r\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/api/resources",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources"]
				}
			},
			"response": []
		},
		{
			"name": "Get Resource by ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/resources/{{resourceId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources", "{{resourceId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Get All Resources (Filters)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/resources?type=LECTURE_HALL&minCapacity=100&location=Building A&status=ACTIVE",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources"],
					"query": [
						{ "key": "type", "value": "LECTURE_HALL" },
						{ "key": "minCapacity", "value": "100" },
						{ "key": "location", "value": "Building A" },
						{ "key": "status", "value": "ACTIVE" }
					]
				}
			},
			"response": []
		},
		{
			"name": "Update Resource (ADMIN)",
			"request": {
				"method": "PUT",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\": \"Lecture Hall 02\",\r\n    \"description\": \"Updated description\",\r\n    \"type\": \"LECTURE_HALL\",\r\n    \"capacity\": 200,\r\n    \"location\": \"Building A, Floor 3\",\r\n    \"availableFrom\": \"09:00:00\",\r\n    \"availableTo\": \"18:00:00\",\r\n    \"status\": \"ACTIVE\",\r\n    \"condition\": \"GOOD\",\r\n    \"inspectionNotes\": \"Minor scratches on desks\"\r\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/api/resources/{{resourceId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources", "{{resourceId}}"]
				}
			},
			"response": []
		},
		{
			"name": "Update Resource Status (ADMIN)",
			"request": {
				"method": "PATCH",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/resources/{{resourceId}}/status?status=OUT_OF_SERVICE",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources", "{{resourceId}}", "status"],
					"query": [
						{ "key": "status", "value": "OUT_OF_SERVICE" }
					]
				}
			},
			"response": []
		},
		{
			"name": "Update Resource Condition (ADMIN)",
			"request": {
				"method": "PATCH",
				"header": [
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"condition\": \"NEEDS_ATTENTION\",\r\n    \"inspectionNotes\": \"Projector not working reliably\"\r\n}",
					"options": { "raw": { "language": "json" } }
				},
				"url": {
					"raw": "{{baseUrl}}/api/resources/{{resourceId}}/condition",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources", "{{resourceId}}", "condition"]
				}
			},
			"response": []
		},
		{
			"name": "Get Resources Needing Attention",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/resources/needs-attention",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources", "needs-attention"]
				}
			},
			"response": []
		},
		{
			"name": "Delete Resource (ADMIN)",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/resources/{{resourceId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "resources", "{{resourceId}}"]
				}
			},
			"response": []
		}
	]
}
